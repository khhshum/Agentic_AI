{
  "size": 0,
  "query": {
    "bool": {
      "filter": [
        {
          "range": {
            "@timestamp": {
              "gte": "2025-08-19T00:00:00",
              "lte": "2025-08-26T23:59:59",
              "format": "yyyy-MM-dd'T'HH:mm:ss"
            }
          }
        }
      ]
    }
  },
  "aggs": {
    "by_10_minutes": {
      "date_histogram": {
        "field": "@timestamp",
        "fixed_interval": "10m",
        "time_zone": "Asia/Hong_Kong"
      },
      "aggs": {
        "max_tx_bytes": {
          "max": {
            "field": "SSIDTable.TxDataBytes"
          }
        },
        "max_rx_bytes": {
          "max": {
            "field": "SSIDTable.RxDataBytes"
          }
        },
        "upload_speed_bits_per_second": {
          "bucket_script": {
            "buckets_path": {
              "max_tx_bytes": "max_tx_bytes"
            },
            "script": "(params.max_tx_bytes * 8) / 600"
          }
        },
        "download_speed_bits_per_second": {
          "bucket_script": {
            "buckets_path": {
              "max_rx_bytes": "max_rx_bytes"
            },
            "script": "(params.max_rx_bytes * 8) / 600"
          }
        },
        "upload_speed_diff": {
          "serial_diff": {
            "buckets_path": "upload_speed_bits_per_second"
          }
        },
        "download_speed_diff": {
          "serial_diff": {
            "buckets_path": "download_speed_bits_per_second"
          }
        }
      }
    }
  }
}